# Copy to .env on the server and fill in. Never commit the real .env.

# --- Required -------------------------------------------------------------------
# A long random string. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Password for the bundled Postgres database.
DB_PASSWORD=
# The address staff will use, e.g. hub.supreme.co.uk
ALLOWED_HOSTS=hub.supreme.co.uk
CSRF_TRUSTED_ORIGINS=https://hub.supreme.co.uk
SITE_URL=https://hub.supreme.co.uk

# --- Branding -------------------------------------------------------------------
SITE_NAME=Supreme Hub
# Optional accent colour for buttons and links. #1E7BC0 is the blue of supreme.co.uk. Empty keeps the Daylight blue.
BRAND_COLOR=#1E7BC0
# Optional logo: a folder name in hub/static/hub/brand/ (logo.png, logo-white.png, icon.png). Empty shows the name only.
BRAND=supreme

# --- Single sign-on (Microsoft Entra ID) ------------------------------------------
# Register an app in Entra ID (App registrations > New registration), single tenant,
# redirect URI: https://hub.supreme.co.uk/oidc/callback/  Then create a client secret.
# For the nightly leaver check, also grant the Microsoft Graph *application* permission
# User.Read.All and click "Grant admin consent".
# Replace TENANT_ID below with the directory (tenant) ID.
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=
OIDC_OP_AUTHORIZATION_ENDPOINT=https://login.microsoftonline.com/TENANT_ID/oauth2/v2.0/authorize
OIDC_OP_TOKEN_ENDPOINT=https://login.microsoftonline.com/TENANT_ID/oauth2/v2.0/token
OIDC_OP_USER_ENDPOINT=https://graph.microsoft.com/oidc/userinfo
OIDC_OP_JWKS_ENDPOINT=https://login.microsoftonline.com/TENANT_ID/discovery/v2.0/keys
# Only these email domains can sign in (keeps directory guests out). Comma-separated.
ALLOWED_EMAIL_DOMAINS=supreme.co.uk
# Google Workspace instead? Use https://accounts.google.com/o/oauth2/v2/auth,
# https://oauth2.googleapis.com/token, https://openidconnect.googleapis.com/v1/userinfo
# and https://www.googleapis.com/oauth2/v3/certs for the four endpoints.

# Emergency/demo only: allow username + password accounts alongside single sign-on.
ALLOW_PASSWORD_LOGIN=0

# --- Email digest (Supreme's SMTP relay) ------------------------------------------
EMAIL_HOST=smtp.supreme.co.uk
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Supreme Hub <hub@supreme.co.uk>

# --- Alerts -----------------------------------------------------------------------
# Who is emailed when the server's disk is filling up. Comma-separated.
ADMIN_EMAILS=it-alerts@supreme.co.uk

# --- Data protection ------------------------------------------------------------
# Bump after editing hub/templates/hub/house_rules.html; everyone is asked to accept again.
POLICY_VERSION=1
# Link to Supreme's staff privacy notice, shown on the house rules page.
PRIVACY_NOTICE_URL=
# Retention in days, as agreed in the DPIA. 0 = keep.
POST_RETENTION_DAYS=0
LEAVER_RETENTION_DAYS=0
NOTIFICATION_RETENTION_DAYS=90

# --- Network ----------------------------------------------------------------------
# Address (or range, e.g. 10.0.0.0/24) of Supreme's HTTPS proxy in front of this server. Only it is trusted
# to say who the visitor is; nginx uses that for its request limits and the app for its security log.
TRUSTED_PROXY=10.0.0.10

# --- Push notifications -------------------------------------------------------------
# Create the pair once with:  docker compose run --rm app python manage.py vapid_keys
# Keep the private key secret. Empty switches push off (in-app alerts and email still work).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:it-alerts@supreme.co.uk

# --- Optional extras --------------------------------------------------------------
# "See translation" under posts and comments: a self-hosted LibreTranslate server, so text stays in-house.
TRANSLATE_URL=
TRANSLATE_API_KEY=
# The "Help" row on the About page: a web page or a mailto: address.
SUPPORT_URL=
# Chat messages older than this many days are removed. 0 = keep.
CHAT_RETENTION_DAYS=0

# --- Optional ---------------------------------------------------------------------
# Port nginx listens on, on the host.
HTTP_PORT=8080
# Turn on once HTTPS works end to end.
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=0
TIME_ZONE=Europe/London

# --- The server runs a release (docs/operations/RELEASES.md) ------------------------
# On the server, remove the # from both lines and put in the HUB_IMAGE= line from the release's own run on GitHub.
# The hub then runs the image the release published and is never built on the server. On a computer, leave them:
# docker compose then builds the hub from this folder.
#COMPOSE_FILE=docker-compose.yml:docker-compose.release.yml
#HUB_IMAGE=ghcr.io/<organisation>/one-supreme:2.0.0@sha256:<digest>
